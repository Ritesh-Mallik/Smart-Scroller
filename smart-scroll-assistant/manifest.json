{
  "manifest_version": 3,
  "name": "Smart Scroll Assistant",
  "description": "Scroll webpages, PDFs, slide previews, and browser documents with voice commands, hand gestures, or normal manual scrolling.",
  "version": "1.0.0",
  "action": {
    "default_title": "Smart Scroll Assistant",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "utils.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "utils.js",
        "handTracking.js",
        "voiceControl.js",
        "vendor/mediapipe/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
